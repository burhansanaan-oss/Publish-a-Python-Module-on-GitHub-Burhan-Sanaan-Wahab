import argparse
import json
import os
from datetime import datetime

# Load tasks from tasks.json file
def load_tasks(filename="tasks.json"):
if not os.path.exists(filename):
# File does not exist, start with empty list
return []
try:
with open(filename, "r") as file:
data = file.read()
if not data:
return []
return json.loads(data)
except json.JSONDecodeError:
print("Error: tasks.json is corrupted. Starting with empty task list.")
return []

# Save tasks list to tasks.json file
def save_tasks(tasks, filename="tasks.json"):
try:
with open(filename, "w") as file:
json.dump(tasks, file, indent=2)
except Exception as e:
print(f"Error saving tasks: {e}")

# Add a new task with optional due date
def add_task(description, due_date):
if not description.strip():
print("Error: Task description cannot be empty.")
return
if due_date:
# Check date format YYYY-MM-DD
try:
datetime.strptime(due_date, "%Y-%m-%d")
except ValueError:
print("Error: Due date format should be YYYY-MM-DD.")
return
tasks = load_tasks()
new_task = {
"id": len(tasks) + 1,
"description": description.strip(),
"timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
"due_date": due_date if due_date else "None",
"completed": False
}
tasks.append(new_task)
save_tasks(tasks)
print(f"Task added! (ID: {new_task['id']})")

# List all tasks (incomplete by default)
def list_tasks(show_all=False):
tasks = load_tasks()
if not tasks:
print("No tasks found.")
return
if not show_all:
tasks = [t for t in tasks if t["completed"] is False]
if not tasks:
print("No incomplete tasks found.")
return
print(f"{'ID':<5}{'Description':<40}{'Due Date':<12}{'Added':<20}{'Status':<10}")
print("-" * 90)
for task in tasks:
status = "Done" if task["completed"] else "Pending"
print(f"{task['id']:<5}{task['description']:<40}{task['due_date']:<12}{task['timestamp']:<20}{status:<10}")

# Search tasks by keyword
def search_tasks(keyword):
if not keyword.strip():
print("Error: Search keyword cannot be empty.")
return
tasks = load_tasks()
results = [t for t in tasks if keyword.lower() in t["description"].lower()]
if not results:
print(f"No tasks match the keyword '{keyword}'.")
return
print(f"Tasks matching '{keyword}':")
print(f"{'ID':<5}{'Description':<40}{'Due Date':<12}{'Added':<20}{'Status':<10}")
print("-" * 90)
for task in results:
status = "Done" if task["completed"] else "Pending"
print(f"{task['id']:<5}{task['description']:<40}{task['due_date']:<12}{task['timestamp']:<20}{status:<10}")

# Mark a task as complete
def mark_complete(task_id):
tasks = load_tasks()
for task in tasks:
if task["id"] == task_id:
task["completed"] = True
save_tasks(tasks)
print(f"Task {task_id} marked complete!")
return
print(f"Task with ID {task_id} not found.")

# Main function to handle CLI commands
def main():
parser = argparse.ArgumentParser(description="Task Manager CLI")
parser.add_argument("--add", help="Add a new task")
parser.add_argument("--due", help="Due date in YYYY-MM-DD format (optional, use with --add)")
parser.add_argument("--list", action="store_true", help="List incomplete tasks")
parser.add_argument("--list-all", action="store_true", help="List all tasks including completed")
parser.add_argument("--search", help="Search tasks by keyword")
parser.add_argument("--complete", type=int, help="Mark a task complete by ID")
args = parser.parse_args()

if args.add:
add_task(args.add, args.due)
elif args.list:
list_tasks(show_all=False)
elif args.list_all:
list_tasks(show_all=True)
elif args.search:
search_tasks(args.search)
elif args.complete is not None:
mark_complete(args.complete)
else:
parser.print_help()

if __name__ == "__main__":
main()
